# Optional — enables the "Catch Tito" game leaderboard (Supabase).
# Leave unset and the game still works, just without the online ranking.
# Copy to `.env` and fill in from your Supabase project (Settings → API).
# The anon key is public/safe to ship; Row Level Security protects the table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
